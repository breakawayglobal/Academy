{
  "rewrites": [
    { "source": "/challenge", "destination": "https://www.visamclub.com/challenge" },
    { "source": "/challenge/:path*", "destination": "https://www.visamclub.com/challenge/:path*" },
    { "source": "/privacy-policy.html", "destination": "https://www.visamclub.com/privacy-policy.html" },
    { "source": "/assets/:path*", "destination": "https://www.visamclub.com/assets/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
